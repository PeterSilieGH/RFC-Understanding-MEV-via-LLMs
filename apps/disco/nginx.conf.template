# Host-networked (see docker-compose.yml): listens on the host port directly
# and proxies APIs over loopback. /api/traces and /api/contracts go to our
# trace-api, /api/mev to our explorer-api (M4 enrichment), the rest of /api
# to the DiscoUI backend (l2b ui from the l2beat submodule).
server {
  listen ${DISCO_WEB_PORT};
  root /usr/share/nginx/html;
  index index.html;

  location /api/traces/ {
    proxy_pass http://127.0.0.1:${TRACE_API_PORT};
    proxy_set_header Host $host;
  }

  location /api/contracts/ {
    proxy_pass http://127.0.0.1:${TRACE_API_PORT};
    proxy_set_header Host $host;
  }

  location /api/mev/ {
    proxy_pass http://127.0.0.1:${EXPLORER_API_PORT};
    proxy_set_header Host $host;
    # /api/mev/tx/:hash aggregates a whole block's MEV facts - can be slow
    proxy_read_timeout 120s;
  }

  # ADR-017 §4: flagging an incident writes to the explorer-api store so it
  # surfaces in the Explorer "Flagged TXs" view across the two origins.
  location /api/flagged {
    proxy_pass http://127.0.0.1:${EXPLORER_API_PORT};
    proxy_set_header Host $host;
  }

  location /api/agent/ {
    proxy_pass http://127.0.0.1:${AGENT_API_PORT};
    proxy_set_header Host $host;
    # analyze/verdict stream NDJSON token-by-token from the LLM: disable
    # buffering so deltas reach the panel live, and allow long-running runs.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 600s;
  }

  location /api/ {
    proxy_pass http://127.0.0.1:${DISCO_API_PORT};
    proxy_set_header Host $host;
    proxy_read_timeout 300s;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
