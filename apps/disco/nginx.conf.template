# Host-networked (see docker-compose.yml): listens on the host port directly
# and proxies APIs over loopback. /api/traces goes to our trace-api, the rest
# of /api to the DiscoUI backend (l2b ui from the l2beat submodule).
server {
  listen ${DISCO_WEB_PORT};
  root /usr/share/nginx/html;
  index index.html;

  location /api/traces/ {
    proxy_pass http://127.0.0.1:${TRACE_API_PORT};
    proxy_set_header Host $host;
  }

  location /api/ {
    proxy_pass http://127.0.0.1:${DISCO_API_PORT};
    proxy_set_header Host $host;
    proxy_read_timeout 300s;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
