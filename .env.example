# ============================================================================
# Unified environment for the whole platform (ADR-002).
# Copy to .env and fill in. Every service (compose containers and local dev)
# reads only this file — no per-package .env files.
# ============================================================================

# --- Ethereum RPC -----------------------------------------------------------
# Node with trace_block + debug_traceTransaction support (reth/Erigon).
# Provided externally; never started by docker compose.
RPC_URL=http://localhost:8504

# Optional additional chains (trace features, discovery)
OPTIMISM_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=

# --- Postgres (single shared instance, ADR-002) -----------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mev_inspect

# --- Service ports ----------------------------------------------------------
EXPLORER_API_PORT=3000
EXPLORER_WEB_PORT=8080
TRACE_API_PORT=2021
TRACE_WEB_PORT=8081
AGENT_API_PORT=3100

# --- mev-inspect-py ---------------------------------------------------------
# Image used for on-demand per-block inspection (built by docker compose).
MEV_INSPECT_IMAGE=mev-inspect-py:local

# --- External APIs ----------------------------------------------------------
# Anthropic (agent-api, pi harness)
ANTHROPIC_API_KEY=
# Etherscan (contract source fallback for trace features)
ETHERSCAN_API_KEY=
# CoinGecko (EUR prices; the free tier works without a key)
COINGECKO_API_KEY=
# Tenderly simulation (optional, legacy framework)
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT_ID=
TENDERLY_PROJECT_SLUG=
# Flashbots (optional, legacy framework)
FLASHBOTS_AUTH_KEY=
FLASHBOTS_SIGNING_KEY=

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=info
