# ============================================================================
# Unified environment for the whole platform (ADR-002).
# Copy to .env and fill in. Every service (compose containers and local dev)
# reads only this file — no per-package .env files.
# ============================================================================

# --- Ethereum RPC -----------------------------------------------------------
# Node with trace_block + debug_traceTransaction support (reth/Erigon).
# Provided externally; never started by docker compose.
RPC_URL=http://localhost:8504
# What containers should use to reach the same node (a host-local node is
# host.docker.internal from inside compose services).
RPC_URL_DOCKER=http://host.docker.internal:8504

# Optional additional chains (trace features, discovery)
OPTIMISM_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=

# --- Postgres (single shared instance, ADR-002) -----------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mev_inspect
# Docker volume for postgres data; set to mev-monitor_mev_inspect_pgdata to
# reuse blocks already inspected by the reference mev-monitor stack. The
# volume is external (never deleted by `docker compose down -v`); on a fresh
# host create it once: docker volume create mev_inspect_pgdata
POSTGRES_VOLUME=mev_inspect_pgdata

# --- Service ports ----------------------------------------------------------
EXPLORER_API_PORT=3000
EXPLORER_WEB_PORT=8080
TRACE_API_PORT=2022
DISCO_API_PORT=2021
DISCOVERY_RUNNER_PORT=2023
DISCO_WEB_PORT=8082
AGENT_API_PORT=3100
# Maximum independent pi runs in flight. Persistent turns for the same
# Discovery session remain serialized even when this is greater than one.
AGENT_MAX_CONCURRENCY=2

# --- Unverified contract decompilation (ADR-016) ---------------------------
# Internal Unix socket shared only by trace-api and the networkless worker.
DECOMPILER_API_SOCKET=/run/decompiler-api/decompiler.sock
# Hard Panoramix subprocess deadline. The trace-api client deadline stays
# slightly larger so it receives the worker's typed timeout response.
DECOMPILER_TIMEOUT_MS=30000
DECOMPILER_REQUEST_TIMEOUT_MS=35000

# pgAdmin (Postgres web UI) — port and login credentials
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@mev.dev
PGADMIN_PASSWORD=admin

# disco-api runs as this host uid/gid so projects created from the UI land
# in l2beat/packages/config/src/projects with your ownership.
DISCO_UID=1000
DISCO_GID=1000
# Max sockets disco-api (incl. `l2b discover` runs) may hold toward the RPC
# node - it caps concurrent connections server-side and unbounded discovery
# starves every other service (scripts/limit-rpc-sockets.cjs).
RPC_MAX_SOCKETS=1000
# Bound eth_getLogs to the most recent N blocks (scripts/bound-getlogs.cjs).
# The node has no log index, so discovery's full-history proxy-upgrade scans
# would run for hours; $pastUpgrades only covers this window as a result.
RPC_GETLOGS_MAX_BLOCKS=1000000
# Proactive page size used by the monorepo-owned discovery RPC adapter. Provider
# range errors are split further automatically.
RPC_GETLOGS_PAGE_SIZE=100000

# --- Native inspector (ADR-010) ---------------------------------------------
# Block inspection is in-process in explorer-api via @mev/inspect (no
# mev-inspect-py image). Per-block budget: abort a block whose trace fetch runs
# longer than this (a degraded RPC node otherwise hangs it). Default: 5 minutes.
#INSPECT_TIMEOUT_MS=300000
# When true, explorer-api continuously inspects new blocks as the chain
# advances (in addition to on-demand + backfill). Default: false.
#INSPECTOR_FOLLOW_HEAD=false
# Exhaustive-coverage fill worker (ADR-011 §1). When true, explorer-api walks
# the chain from INSPECT_FLOOR_BLOCK up to the head, one block at a time through
# the shared serial queue, filling the next uncovered block. Default: false.
#INSPECTOR_FILL_RANGE=false
# Floor block the exhaustive fill (and the value-timeline graph) start from.
# Default: 11,000,000.
#INSPECT_FLOOR_BLOCK=11000000

# --- Agentic analysis (agent-api, pi harness, ADR-009) ----------------------
# agent-api does NOT bake in a model or an API key. Credentials and the model
# to run come from your pi agent dir (auth.json / models.json / settings.json).
# Point this at that dir on the host; compose mounts it into the container and
# exposes it as $PI_CODING_AGENT_DIR. Configure it once with `pi` on the host.
PI_AGENT_DIR=${HOME}/.pi/agent

# --- External APIs ----------------------------------------------------------
# Anthropic key — only a fallback; the pi agent dir above is the primary source
# of credentials for agent-api. Still used by the legacy framework.
ANTHROPIC_API_KEY=
# Etherscan (contract source fallback for trace features)
ETHERSCAN_API_KEY=
# CoinGecko (EUR prices; the free tier works without a key)
COINGECKO_API_KEY=
# Tenderly simulation (optional, legacy framework)
TENDERLY_ACCESS_KEY=
TENDERLY_ACCOUNT_ID=
TENDERLY_PROJECT_SLUG=
# Flashbots (optional, legacy framework)
FLASHBOTS_AUTH_KEY=
FLASHBOTS_SIGNING_KEY=

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=info
